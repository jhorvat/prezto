# Source Prezto.
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

# Customize to your needs...
export DEVELOPER_SETUP_ROOT=$HOME/Workspace/developer-setup
export PIP_EXTRA_INDEX_URL=https://pypi.fury.io/$GEMFURY_TOKEN/dialogue
export ANDROID_HOME=/Users/$USER/Library/Android/sdk
export JAVA_HOME="/Applications/Android Studio.app/Contents/jbr/Contents/Home"
export PATH=${PATH}:$ANDROID_HOME/tools:$ANDROID_HOME/platform-tools:$HOME/.local/bin
fpath=(/usr/local/share/zsh-completions $fpath)
export LIBRARY_PATH=$LIBRARY_PATH:/usr/local/opt/openssl/lib/

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

eval "$(pyenv init -)"
eval "$(direnv hook zsh)"

# begin appcenter completion
. <(appcenter --completion)
# end appcenter completion

command -v pyenv >/dev/null || export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init -)"

source ~/.dia_zshrc
